{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.codex/hooks/inject-guardrails.sh",
            "timeout": 15,
            "statusMessage": "Injecting guardrails"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.codex/hooks/mark-mutation.sh",
            "timeout": 15,
            "statusMessage": "Recording mutation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME\"/.codex/hooks/review-before-stop.sh",
            "timeout": 15,
            "statusMessage": "Requesting review of the final result"
          }
        ]
      }
    ]
  }
}
