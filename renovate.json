{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "packageRules": [
    {
      "description": "Wait 14 days before updating core mise tools",
      "matchManagers": ["mise"],
      "matchDepNames": ["go", "node", "python", "rust"],
      "minimumReleaseAge": "14 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:anthropics/claude-code"],
      "overrideDatasource": "github-releases",
      "overridePackageName": "anthropics/claude-code",
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:aws/aws-cli"],
      "overrideDatasource": "github-tags",
      "overridePackageName": "aws/aws-cli",
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:kubernetes-sigs/kustomize"],
      "extractVersion": "^kustomize/v(?<version>.+)$"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:kubernetes/kubernetes/kubectl"],
      "overrideDatasource": "github-tags",
      "overridePackageName": "kubernetes/kubernetes",
      "extractVersion": "^v?(?<version>.+)$",
      "allowedVersions": "!/-(alpha|beta|rc)/"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:openai/codex"],
      "extractVersion": "^rust-v(?<version>.+)$"
    }
  ]
}
